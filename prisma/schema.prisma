generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
}

model Chat {
  id                String    @id
  username          String
  userId            String
  state             Int
  stateData         String?
  isPaused          Boolean
  scheduleId        String?
  scheduledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  messages          Message[]
  englishLevel      String?
  preparationMonths Int?
  targetScore       Int?
  seenQuizIds       String[]  @default([])
  planStart         DateTime?
  planDurationDays  Int?
  wordOrder         String[]  @default([])
}

model Message {
  id            String    @default(uuid())
  chat          Chat      @relation(fields: [chatId], references: [id])
  chatId        String
  content       String
  details       String
  createdAt     DateTime
  number        Int
  deleted       Boolean
  type          Int
  dates         String
  last          DateTime
  next          DateTime?
  invokeCounter Int
  kind          String    @default("memo")
  refId         String?

  @@id([chatId, id])
  @@index([chatId, kind])
}

model Word {
  id            String  @id @default(uuid(7))
  word          String
  description   String?
  type          String?
  level         String?
  frequency     Float?
  satFrequency  Int?
  voice         Bytes?
  transcription String?
  example       String?
  image         Bytes?
  satQuiz       Json?
  wordQuiz      Json?
}

model Quiz {
  id         String  @id @default(uuid(7))
  question   String
  table_md   String?
  attachment Bytes?
  answers    Json
  correct    Int
  index      Int
}
