generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
}

model Chat {
  id                String    @id
  username          String
  userId            String
  state             Int
  stateData         String?
  isPaused          Boolean
  scheduleId        String?
  scheduledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  messages          Message[]
  englishLevel      String?
  preparationMonths Int?
  targetScore       Int?
  seenQuizIds       String[]  @default([])
  planStart         DateTime?
  planDurationDays  Int?
  wordOrder         String[]  @default([])
}

model Message {
  id            String    @default(uuid())
  chat          Chat      @relation(fields: [chatId], references: [id])
  chatId        String
  content       String
  details       String
  createdAt     DateTime
  number        Int
  deleted       Boolean
  type          Int
  dates         String
  last          DateTime
  next          DateTime?
  invokeCounter Int
  kind          String    @default("memo")
  refId         String?

  @@id([chatId, id])
  @@index([chatId, kind])
}

// Which word each scheduled word-step message was about, so a reply to it (e.g. a voice
// message for pronunciation) resolves to that word even when the message itself doesn't
// name it (a picture, a poll, the missing-word sentence).
model SentWordMessage {
  chatId    String
  messageId Int
  wordId    String
  createdAt DateTime @default(now())

  @@id([chatId, messageId])
}

model Word {
  id            String  @id @default(uuid(7))
  word          String
  description   String?
  type          String?
  level         String?
  frequency     Float?
  satFrequency  Int?
  voice         Bytes?
  transcription String?
  example       String?
  image         Bytes?
  satQuiz       Json?
  wordQuiz      Json?
  embedding     Json?
}

model Quiz {
  id         String  @id @default(uuid(7))
  question   String
  table_md   String?
  attachment Bytes?
  answers    Json
  correct    Int
  index      Int
}

// A Word Duel game (Telegram mini app). The board and moves live in `state` (see
// src/duel/engine.ts); `version` guards against two players or instances saving at once.
model Duel {
  id            String   @id @default(uuid(7))
  player0       String
  name0         String
  player1       String?
  name1         String?
  vsBot         Boolean  @default(false)
  status        String
  state         Json
  notifications Json?
  version       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([player0, updatedAt])
  @@index([player1, updatedAt])
}
